# Database Configuration (MySQL / Aiven Cloud / Local MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=defaultdb

# Optional: Path to custom CA certificate for strict SSL (e.g. ./aiven-ca.pem)
# If omitted on remote/cloud hosts, SSL is used with standard TLS trust
# DB_SSL_CA_PATH=./aiven-ca.pem
# DB_SSL_REJECT_UNAUTHORIZED=false

# Authentication Secret
JWT_SECRET=replace_with_a_secure_random_string_for_production

# Server Port (defaults to 3001)
PORT=3001
